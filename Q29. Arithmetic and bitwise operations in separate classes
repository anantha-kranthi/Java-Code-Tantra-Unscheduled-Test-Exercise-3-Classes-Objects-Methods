import java.util.Scanner;
 
class ArithmeticOperations {
    public int add(int a, int b) { return a + b; }
    public int subtract(int a, int b) { return a - b; }
    public int multiply(int a, int b) { return a * b; }
    public int divide(int a, int b) { return a / b; }
    public int modulus(int a, int b) { return a % b; }
}
 
class BitwiseOperations {
    public int andOp(int a, int b) { return a & b; }
    public int orOp(int a, int b) { return a | b; }
    public int xorOp(int a, int b) { return a ^ b; }
    public int leftShift(int a, int n) { return a << n; }
    public int rightShift(int a, int n) { return a >> n; }
}
 
public class Operations {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        ArithmeticOperations ar = new ArithmeticOperations();
        BitwiseOperations bw = new BitwiseOperations();
        int num1 = sc.nextInt();
        int num2 = sc.nextInt();
        System.out.println(ar.add(num1, num2));
        System.out.println(ar.subtract(num1, num2));
        System.out.println(ar.multiply(num1, num2));
        System.out.println(ar.divide(num1, num2));
        System.out.println(ar.modulus(num1, num2));
        System.out.println(bw.andOp(num1, num2));
        System.out.println(bw.orOp(num1, num2));
        System.out.println(bw.xorOp(num1, num2));
        System.out.println(bw.leftShift(num1, 2));
        System.out.println(bw.rightShift(num1, 2));
        sc.close();
    }
}
