import java.util.Scanner;
 
class Car {
    String brand;
    String model;
    double fuelCapacity;
    double mileage;
 
    Car(String brand, String model, double fuelCapacity, double mileage) {
        this.brand = brand;
        this.model = model;
        this.fuelCapacity = fuelCapacity;
        this.mileage = mileage;
    }
 
    void calculateRange() {
        double range = fuelCapacity * mileage;
        System.out.printf("%.2f%n", range);
    }
 
    void calculateFuelRequired(double distance) {
        double fuel = distance / mileage;
        System.out.printf("%.2f%n", fuel);
    }
}
 
public class CarFuelEfficiency {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String brand = sc.nextLine().trim();
        String model = sc.nextLine().trim();
        double capacity = Double.parseDouble(sc.nextLine().trim());
        double mileage = Double.parseDouble(sc.nextLine().trim());
        double distance = Double.parseDouble(sc.nextLine().trim());
        Car car = new Car(brand, model, capacity, mileage);
        car.calculateRange();
        car.calculateFuelRequired(distance);
        sc.close();
    }
}
